generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activations {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  code         String    @db.VarChar(120)
  completed    Boolean   @default(false)
  completed_at DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([user_id], map: "activations_user_id_index")
}

model admin_notifications {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title        String
  action_label String?
  action_url   String?
  description  String?   @db.VarChar(400)
  read_at      DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  permission   String?
}

model ads {
  id                     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name                   String
  expired_at             DateTime? @db.DateTime(0)
  location               String?   @db.VarChar(120)
  key                    String    @unique(map: "ads_key_unique") @db.VarChar(120)
  image                  String?
  url                    String?
  clicked                BigInt    @default(0)
  order                  Int?      @default(0)
  status                 String    @default("published") @db.VarChar(60)
  created_at             DateTime? @db.Timestamp(0)
  updated_at             DateTime? @db.Timestamp(0)
  open_in_new_tab        Boolean   @default(true)
  tablet_image           String?
  mobile_image           String?
  ads_type               String?
  google_adsense_slot_id String?
}

model ads_translations {
  lang_code    String
  ads_id       BigInt  @db.UnsignedBigInt
  name         String?
  image        String?
  url          String?
  tablet_image String?
  mobile_image String?

  @@id([lang_code, ads_id])
}

model audit_histories {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  user_type      String?   @default("Botble\\ACL\\Models\\User")
  module         String    @db.VarChar(60)
  request        String?   @db.LongText
  action         String    @db.VarChar(120)
  user_agent     String?   @db.Text
  ip_address     String?   @db.VarChar(45)
  actor_id       BigInt    @db.UnsignedBigInt
  actor_type     String?   @default("Botble\\ACL\\Models\\User")
  reference_id   BigInt    @db.UnsignedBigInt
  reference_name String
  type           String    @db.VarChar(20)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([module], map: "audit_histories_module_index")
  @@index([user_id], map: "audit_histories_user_id_index")
}

model cache {
  key        String @id
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id
  owner      String
  expiration Int
}

model categories {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(120)
  parent_id   BigInt    @default(0) @db.UnsignedBigInt
  description String?   @db.VarChar(400)
  status      String    @default("published") @db.VarChar(60)
  author_id   BigInt?   @db.UnsignedBigInt
  author_type String    @default("Botble\\ACL\\Models\\User")
  icon        String?   @db.VarChar(60)
  order       Int       @default(0) @db.UnsignedInt
  is_featured Int       @default(0) @db.TinyInt
  is_default  Int       @default(0) @db.UnsignedTinyInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  @@index([created_at], map: "categories_created_at_index")
  @@index([parent_id], map: "categories_parent_id_index")
  @@index([status], map: "categories_status_index")
}

model categories_translations {
  lang_code     String  @db.VarChar(20)
  categories_id BigInt  @db.UnsignedBigInt
  name          String?
  description   String? @db.VarChar(400)

  @@id([lang_code, categories_id])
  @@index([categories_id], map: "idx_categories_trans_categories_id")
  @@index([categories_id, lang_code], map: "idx_categories_trans_category_lang")
}

model cities {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(120)
  slug       String?   @unique(map: "cities_slug_unique") @db.VarChar(120)
  state_id   BigInt?   @db.UnsignedBigInt
  country_id BigInt?   @db.UnsignedBigInt
  record_id  String?   @db.VarChar(40)
  order      Int       @default(0) @db.TinyInt
  image      String?
  is_default Int       @default(0) @db.UnsignedTinyInt
  status     String    @default("published") @db.VarChar(60)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  zip_code   String?   @db.VarChar(20)

  @@index([name], map: "idx_cities_name")
  @@index([state_id], map: "idx_cities_state_id")
  @@index([state_id, status], map: "idx_cities_state_status")
  @@index([status], map: "idx_cities_status")
}

model cities_translations {
  lang_code String  @db.VarChar(20)
  cities_id BigInt  @db.UnsignedBigInt
  name      String? @db.VarChar(120)
  slug      String? @db.VarChar(120)

  @@id([lang_code, cities_id])
  @@index([cities_id], map: "idx_cities_trans_cities_id")
  @@index([cities_id, lang_code], map: "idx_cities_trans_city_lang")
  @@index([name], map: "idx_cities_trans_name")
}

