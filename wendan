```php
<?php
// ========================================
// 文件: app/Services/AiCoordinator.php
// 说明: CEO 智能路由逻辑
// 作者: AI Multi-Industry System
// ========================================

namespace App\Services;

use OpenAI\Client;

/**
 * AI 协调员 - 就像一个公司的CEO
 * 
 * 职责:
 * 1. 接收用户的消息
 * 2. 分析用户需要的是什么 (哪个行业？哪个员工？)
 * 3. 路由消息到对应的 AI 员工
 * 4. 返回 AI 员工的回复
 */
class AiCoordinator
{
    /**
     * 主方法: 处理用户消息
     * 
     * @param string $message 用户输入的消息
     * @param string $merchantId 商户ID
     * @return array 返回格式:
     *   - industry: 识别的行业 (fashion/food/retail/beauty/hotel/auto)
     *   - employee: 选中的员工 (designer/purchaser/operator/marketer/etc)
     *   - response: AI 的回复
     *   - confidence: 置信度 (0-100)
     * 
     * @example
     *   $result = $coordinator->routeMessage("帮我设计服装", "merchant_123");
     *   // 返回:
     *   // {
     *   //   "industry": "fashion",
     *   //   "employee": "designer",
     *   //   "response": "我可以帮你设计...",
     *   //   "confidence": 95
     *   // }
     */
    public function routeMessage(string $message, string $merchantId): array
    {
        // 步骤1: 分析消息，识别行业和员工
        // CEO 用 OpenAI 的智能分析能力来理解用户需要什么
        $analysis = $this->analyzeMessage($message);
        
        // 步骤2: 从分析结果中提取行业和员工
        $industry = $analysis['industry'];      // 例如: "fashion"
        $employee = $analysis['employee'];      // 例如: "designer"
        
        // 步骤3: 获取对应员工的系统提示词
        // 这个提示词定义了该员工的角色、职责、回答风格
        $prompt = $this->getEmployeePrompt($industry, $employee);
        
        // 步骤4: 调用 OpenAI API，让 AI 员工回复
        $response = $this->callAiEmployee($prompt, $message);
        
        // 步骤5: 保存聊天记录到数据库
        $this->saveChatMessage(
            merchantId: $merchantId,
            industry: $industry,
            employee: $employee,
            userMessage: $message,
            aiResponse: $response
        );
        
        // 步骤6: 返回结果
        return [
            'industry' => $industry,
            'employee' => $employee,
            'response' => $response,
            'confidence' => $analysis['confidence'] ?? 85,
        ];
    }
    
    /**
     * 第一步: 分析用户消息
     * 目的: 理解用户说什么，需要找哪个行业的哪个员工
     */
    private function analyzeMessage(string $message): array
    {
        // 用 OpenAI 的分析能力
        // 发送一个"分类提示词"给 OpenAI，让它告诉我们：
        // - 这个消息属于哪个行业？
        // - 需要哪个员工来处理？
        // - 确定程度有多高？
        
        $classificationPrompt = <<<PROMPT
        分析下面的用户消息，判断需要哪个行业的哪个员工来处理。
        
        返回JSON格式:
        {
            "industry": "fashion|food|retail|beauty|hotel|auto",
            "employee": "designer|purchaser|operator|marketer|...",
            "confidence": 0-100
        }
        
        用户消息: {$message}
        PROMPT;
        
        // 调用 OpenAI
        $result = $this->openAi()->chat()->create([
            'model' => 'gpt-4',
            'messages' => [
                ['role' => 'system', 'content' => '你是一个消息分类助手'],
                ['role' => 'user', 'content' => $classificationPrompt],
            ],
        ]);
        
        // 解析返回的JSON
        return json_decode(
            $result->choices[0]->message->content,
            true
        );
    }
    
    /**
     * 第二步: 获取员工的系统提示词
     * 
     * 系统提示词的作用:
     * - 告诉 AI 它是谁 (例如: "你是一个服装设计师")
     * - 它的职责是什么
     * - 它应该如何回答
     */
    private function getEmployeePrompt(string $industry, string $employee): string
    {
        // 从配置文件读取对应的提示词
        $config = config('ai-industries');
        
        $prompt = $config[$industry]['employees'][$employee]['system_prompt'] 
            ?? 'You are a helpful AI assistant.';
        
        return $prompt;
    }
    
    /**
     * 第三步: 调用 OpenAI API
     * 这是真正的 AI 执行步骤
     */
    private function callAiEmployee(string $prompt, string $message): string
    {
        $response = $this->openAi()->chat()->create([
            'model' => 'gpt-4',
            'messages' => [
                ['role' => 'system', 'content' => $prompt],
                ['role' => 'user', 'content' => $message],
            ],
            'temperature' => 0.7,      // 创意程度 (0=精确, 1=创意)
            'max_tokens' => 2000,      // 最多回复字数
        ]);
        
        // 提取回复文本
        return $response->choices[0]->message->content;
    }
    
    /**
     * 第四步: 保存聊天记录
     * 用于后面查询和分析
     */
    private function saveChatMessage(
        string $merchantId,
        string $industry,
        string $employee,
        string $userMessage,
        string $aiResponse
    ): void {
        // 保存到数据库
        AiChatMessage::create([
            'merchant_id' => $merchantId,
            'industry' => $industry,
            'employee' => $employee,
            'user_message' => $userMessage,
            'ai_response' => $aiResponse,
            'created_at' => now(),
        ]);
    }
    
    /**
     * 辅助方法: 获取 OpenAI 客户端
     */
    private function openAi(): Client
    {
        return \OpenAI::client(config('services.openai.key'));
    }
}
