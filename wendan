<script setup>
import { ref } from 'vue'

// 定义变量
const isOpen = ref(false)                    // 聊天窗口是否打开
const inputMessage = ref('')                // 输入框内容
const messages = ref([])                    // 消息列表
const isLoading = ref(false)                // 是否正在加载 AI 回复

// Props (从父组件接收)
const props = defineProps({
  merchantId: {
    type: String,
    required: true,
  },
})

// 方法1: 切换聊天窗口显示/隐藏
const toggleChat = () => {
  isOpen.value = !isOpen.value
  
  // 如果是第一次打开，显示欢迎消息
  if (isOpen.value && messages.value.length === 0) {
    messages.value.push({
      type: 'ai',
      content: '👋 你好！我是AI助手。有什么我可以帮你的吗？',
    })
  }
}

// 方法2: 发送消息
const sendMessage = async () => {
  // 如果输入为空或正在加载，不做任何事
  if (!inputMessage.value.trim() || isLoading.value) {
    return
  }

  // 保存用户消息
  const userMsg = inputMessage.value
  messages.value.push({
    type: 'user',
    content: userMsg,
  })
  inputMessage.value = ''
  isLoading.value = true

  try {
    // 调用后端 API
    const response = await fetch('/api/ai/chat', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        message: userMsg,
        merchant_id: props.merchantId,
      }),
    })

    const data = await response.json()

    // 显示 AI 回复
    messages.value.push({
      type: 'ai',
      content: data.response,
    })

    // 可选: 显示 AI 选中的员工信息
    console.log(`AI: ${data.industry} - ${data.employee}`)
  } catch (error) {
    console.error('发送消息出错:', error)
    messages.value.push({
      type: 'ai',
      content: '❌ 抱歉，出错了。请稍后重试。',
    })
  } finally {
    isLoading.value = false
  }
}
</script>

