{
  "name": "yourname/ai-multi-industry-system",
  "description": "AI Multi-Industry Employee Management System",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.22",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
