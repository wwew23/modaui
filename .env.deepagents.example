# DeepAgents 集成 - 环境配置示例

# DeepAgents 后端服务 URL
# 开发环境: http://localhost:8001
# 生产环境: https://api.deepagents.example.com (替换为实际域名)
DEEPAGENTS_URL=http://localhost:8001

# DeepAgents 调试模式 (生产设为 false)
DEEPAGENTS_DEBUG=true

# DeepAgents 请求超时时间（秒）- 复杂分析任务可能需要 60-120 秒
DEEPAGENTS_TIMEOUT=120

# DeepAgents API 认证（如需要）
# DEEPAGENTS_API_KEY=your-api-key
# DEEPAGENTS_API_SECRET=your-api-secret
